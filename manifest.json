{
  "manifest_version": 3,
  "name": "Sound Tools",
  "version": "1.1.0",
  "description": "Real-time audio effects (distortion, reverb, filter) for any website, controllable with a MIDI controller.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "Sound Tools"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
